{
  "$schema": "https://raw.githubusercontent.com/nicepkg/vscode-tauri/dev/packages/vscode-tauri/src/lib/schema.json",
  "productName": "VanishTrans",
  "version": "0.1.0",
  "identifier": "com.vanish-trans.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "ball",
        "title": "",
        "width": 58,
        "height": 38,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": true,
        "x": 100,
        "y": 100
      },
      {
        "label": "quick",
        "title": "",
        "width": 392,
        "height": 188,
        "minWidth": 392,
        "maxWidth": 392,
        "minHeight": 132,
        "maxHeight": 330,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' https:; img-src 'self' asset: data: https:; font-src 'self'"
    }
  },
  "plugins": {
    "global-shortcut": null,
    "clipboard-manager": null
  }
}
