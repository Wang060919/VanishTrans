{
  "$schema": "https://raw.githubusercontent.com/nicepkg/vscode-tauri/dev/packages/vscode-tauri/src/lib/schema.json",
  "productName": "VanishTrans",
  "version": "0.1.0",
  "identifier": "com.vanish-trans.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm run dev",
    "beforeBuildCommand": "pnpm run build"
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Wang060919",
    "category": "Utility",
    "shortDescription": "轻量级 AI 驱动的 Windows 翻译工具",
    "longDescription": "基于 Tauri 2 构建的 Windows 翻译工具：划词翻译、原地替换、截图 OCR、翻译记忆与剪贴板监听。",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["SimpChinese", "English"],
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "app": {
    "windows": [
      {
        "label": "ball",
        "title": "",
        "width": 116,
        "height": 42,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "x": 100,
        "y": 100
      },
      {
        "label": "quick",
        "title": "",
        "width": 392,
        "height": 188,
        "minWidth": 392,
        "maxWidth": 392,
        "minHeight": 132,
        "maxHeight": 330,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' https:; img-src 'self' asset: data: https:; font-src 'self'"
    }
  },
  "plugins": {
    "global-shortcut": null,
    "clipboard-manager": null
  }
}
